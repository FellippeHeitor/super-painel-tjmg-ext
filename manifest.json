{
  "manifest_version": 3,
  "name": "Super Painel TJMG",
  "version": "0.2.0",
  "description": "Painel de indicadores da comarca a partir dos painéis Qlik da Rede TJMG. Os dados ficam só no navegador.",
  "action": {
    "default_title": "Super Painel TJMG"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://qlik.tjmg.jus.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://qlik.tjmg.jus.br/*"
      ],
      "js": [
        "src/gancho-ws.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
