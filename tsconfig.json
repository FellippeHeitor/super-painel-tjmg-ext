{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "strict": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "dist",
    "removeComments": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "pages/**/*.ts"]
}
